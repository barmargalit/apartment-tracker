NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Maps integration (feature flag)
# Set NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=true and provide an API key with
# Maps JavaScript API + Places API enabled to unlock the map panel in
# the Residence modal and address autocomplete on the street field.
NEXT_PUBLIC_GOOGLE_MAPS_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
